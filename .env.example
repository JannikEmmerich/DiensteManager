# Template for the local configuration: copy to .env and adjust.
# The .env file contains secrets and must not be committed.

# --- Django ------------------------------------------------------------------
DJANGO_DEBUG=True
# Required as soon as DJANGO_DEBUG=False. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://duties.example.org
# Path of the Django admin (default: admin/)
# DJANGO_ADMIN_URL=admin/
# SITE_NAME=DiensteManager
# INVITATION_VALIDITY_DAYS=14
# Roles that must use two-factor authentication (dispatcher, unit_lead, member; admins
# count as dispatchers; empty = nobody is forced)
# MFA_REQUIRED_ROLES=dispatcher

# --- Database (default: SQLite file db.sqlite3) -------------------------------
# DATABASE_URL=postgres://dienstemanager:password@localhost:5432/dienstemanager

# --- Email (without EMAIL_HOST, emails are only printed to the console) ------
# EMAIL_HOST=smtp.example.org
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=DiensteManager <noreply@example.org>
# Send notifications in the background through the worker (Docker Compose: True)
# EMAIL_QUEUE=True
# Hour (local time) of the daily summary for accounts that want one
# EMAIL_DIGEST_HOUR=18

# --- Data lifecycle: retention periods (0 = keep forever), see README ---------
# RETENTION_REPORTS_DAYS=365        anonymise helpers of duties that ended earlier
# RETENTION_HISTORY_DAYS=730        delete change history entries
# RETENTION_MAILINGS_DAYS=365       delete emails sent by dispatchers
# RETENTION_INVITATIONS_DAYS=180    delete accepted, revoked and expired invitations
# RETENTION_BILLINGS_YEARS=10       delete paid and cancelled billings
# RETENTION_OUTBOX_DAYS=30          delete sent and failed emails from the queue

# --- Sign-in with HiOrg-Server (empty = hidden) -------------------------------
# Credentials are issued on request by HiOrg support, see README.
# HIORG_CLIENT_ID=
# HIORG_CLIENT_SECRET=
# Optional: organisation code preselected on the HiOrg sign-in page
# HIORG_OV=

# --- Only for running with Docker Compose (compose.yaml) ----------------------
# Version of the image from ghcr.io, e.g. 0.2.0 or 0.2 (default: latest release).
# DIENSTEMANAGER_VERSION=latest
# Public host name; Caddy obtains an HTTPS certificate for it automatically.
# DOMAIN=duties.example.org
# Use letters and digits only (it is inserted into a URL).
# POSTGRES_PASSWORD=
# Set to 0 for local tests with DOMAIN=localhost, otherwise browsers remember
# "HTTPS only" for localhost for a year.
# DJANGO_SECURE_HSTS_SECONDS=31536000
